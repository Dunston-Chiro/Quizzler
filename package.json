{
  "name": "quizzler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:ownership": "tsx --env-file=.env.local scripts/test-ownership.ts",
    "test:users": "tsx --env-file=.env.local scripts/test-user-management.ts",
    "test:engine": "tsx --env-file=.env.local scripts/test-participant-quiz.ts",
    "test:live": "tsx --env-file=.env.local scripts/test-admin-live-enhancements.ts",
    "test:governance": "tsx --env-file=.env.local scripts/test-superadmin-governance.ts",
    "seed:superadmin": "node --env-file=.env.local scripts/seed-superadmin.mjs",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^5.9.6",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
