# ==============================================================================
# College Quiz Platform - Environment Variables Template ($0 Budget Stack)
# Copy this file to .env.local and update with your real Neon credentials.
# Do NOT commit .env.local to version control.
# ==============================================================================

# Neon Managed PostgreSQL - Pooled Connection String (Used for Application Traffic)
# Found in Neon Console: Dashboard -> Connection Details -> check "Pooled connection"
# Format: postgresql://<user>:<password>@ep-<project-id>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:<password>@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Managed PostgreSQL - Direct Connection String (Used for Drizzle Migrations)
# Found in Neon Console: Dashboard -> Connection Details -> uncheck "Pooled connection"
# Format: postgresql://<user>:<password>@ep-<project-id>.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:<password>@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Secret key used for signing session JWTs (minimum 32 characters recommended)
# You can generate a random secret via: openssl rand -base64 32
JWT_SECRET=super-secure-change-this-secret-key-for-college-quiz-jwt-auth-2026

# Node Environment ('development' | 'production')
NODE_ENV=development

# Application base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Super-Admin Initialization Credentials (used by scripts/seed-superadmin.mjs)
SUPERADMIN_NAME=Platform Administrator
SUPERADMIN_EMAIL=superadmin@quizplatform.local
SUPERADMIN_PASSWORD=ChangeMeImmediately!SuperSecure123

# Default Quiz Settings
DEFAULT_QUESTION_TIMER_SECONDS=30
